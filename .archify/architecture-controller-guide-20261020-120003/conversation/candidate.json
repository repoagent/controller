  "cards": [
    {
      "dot": "emerald",
      "title": "Already on main",
      "items": [
        "The bridge owns EYES receipts. The native agent owns participant-facing replies.",
        "Native conversation history stays with Codex; the JSON file records IDs and observed versions."
      ]
    },
    {
      "dot": "rose",
      "title": "Uncertain delivery stops this Discussion",
      "items": [
        "A missing acknowledgement leaves pending in the checkpoint. Manual recovery is required.",
        "Other Discussions can continue. Receipt failure after acceptance does not resend accepted input."
      ]
    },
    {
      "dot": "amber",
      "title": "Workspace is a separate future change",
      "items": [
        "Main passes an existing workspace directory to Codex. It does not clone or refresh the repository.",
        "Issue #42 proposes authenticated checkout, exact-root trust and safe default-branch refresh."
      ]
    }
