  "cards": [
    {
      "dot": "amber",
      "title": "Approved design; not implemented on main",
      "items": [
        "Issues #31/#52/#53 replace the earlier broker browser ceremony. The installer performs GitHub env/variable creation; the broker hosts APIs only.",
        "User chooses both names. GitHub authenticates host setup; its credentials never enter the broker or controller. Readable marker metadata identifies exact scope."
      ]
    },
    {
      "dot": "cyan",
      "title": "No approval by self-assertion",
      "items": [
        "Possessing the pending secret or reading a public controller ID is insufficient: the broker independently reads the exact marker from GitHub.",
        "The device has separate private proof and no environment-management permission. A person leaving does not revoke repository-held approval."
      ]
    },
    {
      "dot": "rose",
      "title": "Expiry and response loss",
      "items": [
        "Expired unacknowledged completion revokes the unclaimed device. Retry must not create duplicate devices.",
        "Approved defaults: 15-minute approval window, abandoned-data cleanup within 24 hours; cleanup must work while API replicas are zero."
      ]
    }
  ]
