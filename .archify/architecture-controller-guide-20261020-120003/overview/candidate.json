  "cards": [
    {
      "dot": "cyan",
      "title": "Start with the user journey",
      "items": [
        "A participant writes in GitHub; the controller sends observed changes to native Codex.",
        "Codex uses the response skill and authenticated gh wrapper to reply directly to GitHub."
      ]
    },
    {
      "dot": "emerald",
      "title": "What main already contains",
      "items": [
        "Polling, signed Discussion webhooks, native sessions, checkpoints and renewable App credentials.",
        "Direct-App and broker consumer modes exist. The packaged launcher still supplies a PEM."
      ]
    },
    {
      "dot": "amber",
      "title": "What is proposed",
      "items": [
        "A UI-free Azure auth service supplies repository-bound tokens after reading approval directly from GitHub.",
        "Repository-held approval replaces personal-admin continuity and broker-hosted browser approval. Provider and new installer flow remain unimplemented on this main snapshot."
      ]
    },
    {
      "dot": "violet",
      "title": "Installer-owned setup and recovery",
      "items": [
        "Install scripts create/reuse the GitHub Environment and write the approval variable under host GitHub authority; users choose both names.",
        "Revoke removes the selected approval without the old device secret. Uninstall revokes then removes only the selected managed runtime, preserving data by default. Plan evidence: issue #31/#39; code links are the pinned main baseline."
      ]
    }
  ]
