  "cards": [
    {
      "dot": "emerald",
      "title": "Consumer code already on main",
      "items": [
        "One shared credential lifecycle serves direct-App and broker sources.",
        "Refresh checks run every minute and acquire a new token within five minutes of expiry. Every native gh command rereads the cache."
      ]
    },
    {
      "dot": "rose",
      "title": "Approval removal and outstanding tokens",
      "items": [
        "A confirmed missing/changed marker closes observed enrollment permanently; failed GitHub lookup denies issuance. Recreating the old marker cannot reactivate the grant.",
        "Fresh enrollment is required. Old GitHub tokens and unknown mint outcomes retain the separate #34 replacement barrier; removal is not an instantaneous token recall."
      ]
    },
    {
      "dot": "amber",
      "title": "A behavior contract, not a database design",
      "items": [
        "The diagram names required coordination; it does not claim a database transaction includes the GitHub HTTP call.",
        "Store, partitioning, concurrency, cleanup and recovery need real-provider proof before hosted readiness."
      ]
    }
  ]
