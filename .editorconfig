root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true

[*.cs]
indent_style = space
indent_size = 4
dotnet_sort_system_directives_first = true
# Build-enforced style; IDE0079 is configured for editors (see docs/code-quality.md).
dotnet_diagnostic.IDE0059.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0079.severity = warning
# Correctness and ownership at asynchronous I/O boundaries.
dotnet_diagnostic.CA2016.severity = warning
dotnet_diagnostic.CA2000.severity = warning
dotnet_diagnostic.CA2213.severity = warning
dotnet_diagnostic.CA2012.severity = warning
dotnet_diagnostic.CA2022.severity = warning
dotnet_diagnostic.CA2200.severity = warning
# Protocol identifiers and credential-related APIs.
dotnet_diagnostic.CA1309.severity = warning
dotnet_diagnostic.CA1310.severity = warning
dotnet_diagnostic.CA5350.severity = warning
dotnet_diagnostic.CA5351.severity = warning
dotnet_diagnostic.CA5364.severity = warning
dotnet_diagnostic.CA5359.severity = warning
# Logging adapters; cores keep their existing logging ports.
dotnet_diagnostic.CA2254.severity = warning
dotnet_diagnostic.CA2017.severity = warning
dotnet_diagnostic.CA1848.severity = warning

[src/RepoAgentController.Core/*.cs]
dotnet_diagnostic.RS0030.severity = error

[service/auth/src/RepoAgent.Auth.Core/*.cs]
dotnet_diagnostic.RS0030.severity = error

[{tests/RepoAgentController.Tests,tests/RepoAgent.LiveTests,tests/RepoAgent.AppHostTests,service/auth/tests/RepoAgent.Auth.Tests}/*.cs]
# Public test names are executable stories, not production API identifiers.
dotnet_code_quality.CA1707.api_surface = private, internal
dotnet_diagnostic.xUnit1030.severity = warning
dotnet_diagnostic.xUnit1031.severity = warning
dotnet_diagnostic.xUnit1051.severity = warning
