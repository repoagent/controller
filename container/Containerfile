FROM mcr.microsoft.com/dotnet/sdk:11.0.100-rc.2 AS build
WORKDIR /source
COPY global.json ./
COPY src/ ./src/
COPY .agents/skills/github-discussion/ ./.agents/skills/github-discussion/
RUN apt-get update && apt-get install -y --no-install-recommends clang zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*
RUN dotnet publish src/DiscussionBridge -c Release -o /published --nologo -p:PublishAot=true -p:TreatWarningsAsErrors=true \
    && find /published -name '*.dbg' -delete

FROM mcr.microsoft.com/dotnet/runtime-deps:11.0.0-rc.2 AS runtime
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends bash ca-certificates curl git python3 jq procps \
    ripgrep file patch diffutils unzip zip less openssh-client \
    && rm -rf /var/lib/apt/lists/*
COPY container/install-tools.sh /tmp/install-tools.sh
RUN bash /tmp/install-tools.sh "$TARGETARCH" && rm /tmp/install-tools.sh
RUN existing=$(getent passwd 1000 | cut -d: -f1); if [ -n "$existing" ]; then userdel "$existing"; fi; \
    useradd --uid 1000 --create-home --shell /bin/bash agent \
    && mkdir -p /data/credentials/codex /data/config/skills /data/history /data/state /data/participant /data/control /workspace /home/agent/.agents \
    && ln -s /data/config/skills /home/agent/.agents/skills \
    && ln -s /data/history /data/credentials/codex/sessions \
    && chown -R agent:agent /data /workspace /home/agent
COPY --from=build /published/ /opt/bridge/
COPY container/runtime.py /opt/repoagent/runtime.py
COPY container/control.py /opt/repoagent/control.py
ENV HOME=/home/agent CODEX_HOME=/data/credentials/codex BROWSER=echo
WORKDIR /workspace
USER agent
ENTRYPOINT ["python3", "/opt/repoagent/runtime.py"]
CMD ["versions"]

FROM runtime AS dotnet-development
USER root
COPY --from=build /usr/share/dotnet/ /usr/share/dotnet/
USER agent

FROM build AS live-tests
COPY --from=runtime /usr/local/bin/gh /usr/local/bin/gh
COPY tests/RepoAgent.LiveTests/ /source/tests/RepoAgent.LiveTests/
RUN dotnet build tests/RepoAgent.LiveTests -c Release --nologo
RUN mkdir -p /data/control /data/participant /evidence && chown -R 1000 /data /evidence
USER 1000
ENTRYPOINT ["dotnet", "/source/tests/RepoAgent.LiveTests/bin/Release/net11.0/RepoAgent.LiveTests.dll"]
