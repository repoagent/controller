#!/usr/bin/env bash
# Host orchestration only. Tools, credentials and application execution stay in Docker.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
instance=${REPOAGENT_INSTANCE:-default}
[[ "$instance" =~ ^[a-z0-9][a-z0-9-]{0,40}$ ]] || { echo 'Invalid REPOAGENT_INSTANCE' >&2; exit 1; }
image=${REPOAGENT_IMAGE:-repoagent:local}
name=repoagent-$instance
volumes=()
runtime_volumes=()
for storage in config credentials workspace history state tools; do
  destination=/data/$storage
  [[ "$storage" != workspace ]] || destination=/workspace
  volumes+=(--mount "type=volume,src=$name-$storage,dst=$destination")
  access=''
  [[ "$storage" != config ]] || access=',readonly'
  runtime_volumes+=(--mount "type=volume,src=$name-$storage,dst=$destination$access")
done
interactive=(-i)
[[ ! -t 0 || ! -t 1 ]] || interactive+=(-t)
base=(docker run --rm --init "${volumes[@]}")
config() { "${base[@]}" "$image" "$@"; }
stopped() {
  [[ $(docker inspect --format '{{.State.Running}}' "$name" 2>/dev/null || true) != true ]] || {
    echo 'Stop the agent before changing configuration, credentials or skills.' >&2; exit 1;
  }
}
key_mount() {
  local key
  key=$(config get keyPath)
  [[ -f "$key" ]] || { echo 'Configured private-key file is missing.' >&2; exit 1; }
  key_args=(--mount "type=bind,src=$key,dst=/run/secrets/github-app.pem,readonly")
}
start() {
  key_mount
  [[ $(docker inspect --format '{{.State.Running}}' "$name" 2>/dev/null || true) != true ]] || {
    echo "$name is already running."; return;
  }
  docker rm "$name" >/dev/null 2>&1 || true
  local mode port
  mode=$(config get mode)
  network_args=()
  if [[ "$mode" == fixed-url ]]; then
    port=$(config get listenPort)
    # An external HTTPS proxy forwards to this loopback-only development mapping.
    network_args=(--publish "127.0.0.1:$port:$port")
  fi
  # Runtime start updates tools, then verifies Codex/App identity before native work.
  docker run -d --init --name "$name" "${network_args[@]}" "${runtime_volumes[@]}" "${key_args[@]}" "$image" start
  local deadline=$((SECONDS + 600))
  while (( SECONDS < deadline )); do
    if [[ $(docker inspect --format '{{.State.Running}}' "$name") != true ]]; then
      docker logs "$name" >&2
      echo 'Agent startup failed; inspect the output above.' >&2
      return 1
    fi
    local output
    output=$(docker logs "$name" 2>&1)
    if [[ "$output" == *' ready repository='* ]]; then
      printf '%s\n' "$output"
      return 0
    fi
    docker exec "$name" sh -c 'sleep 1' >/dev/null 2>&1 || true
  done
  docker logs "$name" >&2
  docker stop --timeout 20 "$name" >/dev/null
  echo 'Startup did not become ready within ten minutes; container stopped.' >&2
  return 1
}
case "${1:-help}" in
  build)
    shift; exec bash "$root/scripts/build-image.sh" "$@" ;;
  setup) stopped; shift; exec bash "$root/scripts/setup-wizard.sh" --skip-build --no-start "$@" ;;
  configure) stopped; shift; config configure "$@" ;;
  get) shift; config get "$@" ;;
  login) stopped; shift; "${base[@]}" "${interactive[@]}" "$image" login "$@" ;;
  import-codex-auth)
    stopped
    [[ ${2:-} = /* && -f "$2" ]] || { echo 'Supply an explicit absolute auth.json file path.' >&2; exit 1; }
    "${base[@]}" --mount "type=bind,src=$2,dst=/run/secrets/codex-auth.json,readonly" --entrypoint python3 "$image" -c \
      'import json,pathlib; p=pathlib.Path("/run/secrets/codex-auth.json"); json.loads(p.read_text()); d=pathlib.Path("/data/credentials/codex/auth.json"); d.write_bytes(p.read_bytes()); d.chmod(0o600)' ;;
  skills)
    if [[ ${2:-} == install ]]; then
      stopped
      [[ ${3:-} = /* && -f "$3" ]] || { echo 'Supply an absolute skills.json file path.' >&2; exit 1; }
      extra=(--mount "type=bind,src=$3,dst=/run/skills.json,readonly")
      token=()
      if [[ -n ${4:-} ]]; then
        [[ "$4" = /* && -f "$4" ]] || { echo 'Skill token file must be an existing absolute path.' >&2; exit 1; }
        extra+=(--mount "type=bind,src=$4,dst=/run/secrets/skill-token,readonly")
        token=(--token-file /run/secrets/skill-token)
      fi
      "${base[@]}" "${extra[@]}" "$image" install-skills /run/skills.json "${token[@]}"
    else config skills; fi ;;
  check) stopped; key_mount; "${base[@]}" "${key_args[@]}" "$image" check ;;
  start) start ;;
  stop) docker stop --timeout 20 "$name" ;;
  restart) "$root/repoagent" stop; start ;;
  logs) shift; docker logs "$name" "$@" ;;
  versions) config versions ;;
  state) config state ;;
  enroll) stopped; shift; config enroll "$@" ;;
  participant-login)
    docker run --rm --init "${interactive[@]}" --mount "type=volume,src=$name-participant,dst=/data/participant" "$image" participant-login ;;
  participant-identity)
    docker run --rm --mount "type=volume,src=$name-participant,dst=/data/participant" "$image" participant-identity ;;
  import-participant-token)
    [[ ${2:-} = /* && -f "$2" ]] || { echo 'Supply an explicit absolute participant token file.' >&2; exit 1; }
    docker run --rm --mount "type=volume,src=$name-participant,dst=/data/participant" \
      --mount "type=bind,src=$2,dst=/run/secrets/participant-token,readonly" -e GH_CONFIG_DIR=/data/participant \
      --entrypoint sh "$image" -c 'gh auth login --hostname github.com --git-protocol https --with-token < /run/secrets/participant-token' ;;
  live-test) shift; exec bash "$root/scripts/live-test.sh" "$@" ;;
  reset)
    [[ ${2:-} == --delete-stored-data ]] || {
      echo 'This removes stored Codex/participant credentials, workspace, native history and bridge state.' >&2
      echo 'Use ./repoagent reset --delete-stored-data only after backing up anything needed.' >&2; exit 1;
    }
    docker rm -f "$name" >/dev/null 2>&1 || true
    docker volume rm "$name-config" "$name-credentials" "$name-workspace" "$name-history" "$name-state" "$name-tools" "$name-participant" ;;
  *)
    cat <<'USAGE'
Usage: ./repoagent COMMAND
  build                           Build pinned bridge, .NET, gh and Codex image
  setup                           Guided App configuration and Codex browser sign-in
  configure --repository OWNER/REPO --app-id ID --key-path /absolute/key.pem
            [--installation-id ID] [--mention-user LOGIN] [--model MODEL] [--tool-updates latest|pinned]
            [--mode polling|fixed-url|quick-tunnel] [--public-url https://HOST] [--listen-port 8080] [--reconcile-interval 300]
  login                           Container-owned Codex device sign-in (reuses valid login)
  import-codex-auth /path/auth.json Explicitly copy an existing Codex auth cache
  skills install /path/skills.json [/path/private-source-token]
  skills | versions | check       Inspect selection/tools or check real authentication
  start | stop | restart          Operate the agent; replacement retains its volumes
  logs [--follow] | state         Inspect operational output or conversation checkpoint
  enroll DISCUSSION_URL ...       Persist explicit enrollments while stopped
  participant-login              Separate human gh browser sign-in for live tests
  participant-identity           Show the separate participant login
  import-participant-token /path  Explicit token-file alternative for the test participant
  live-test                       Opt-in real-provider xUnit acceptance journey
  reset --delete-stored-data      Explicitly delete this instance's stored data
Set REPOAGENT_INSTANCE to isolate another repository/test instance (default: default).
USAGE
    ;;
esac
