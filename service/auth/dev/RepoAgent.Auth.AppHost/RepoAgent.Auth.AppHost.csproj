<Project Sdk="Microsoft.NET.Sdk">
  <Sdk Name="Aspire.AppHost.Sdk" Version="13.6.2" />
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AspireUseCliBundle>true</AspireUseCliBundle>
    <UserSecretsId>repoagent-auth-apphost</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" Version="13.6.2" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" Version="13.6.2" />
    <PackageReference Include="AzureKeyVaultEmulator.Aspire.Hosting" Version="3.1.5" />
    <ProjectReference Include="../../src/RepoAgent.Auth/RepoAgent.Auth.csproj" />
    <ProjectReference Include="../RepoAgent.Auth.DevInit/RepoAgent.Auth.DevInit.csproj" />
  </ItemGroup>
</Project>
