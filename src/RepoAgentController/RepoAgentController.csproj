<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../releases/controller/version.txt').Trim())</Version>
    <ControllerReleaseNotesPath Condition="'$(ControllerReleaseNotesPath)' == ''">$(MSBuildThisFileDirectory)../../releases/controller/RELEASE_NOTES.md</ControllerReleaseNotesPath>
    <AssemblyName>RepoAgentController</AssemblyName>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The image publishes Native AOT with every warning as an error. Run the same
         trim/AOT analyzers on every build so ordinary builds and tests fail first. -->
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <!-- Kestrel and minimal APIs on the slim builder (ADR 0009); part of the shared framework, so no package version. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="System.CommandLine" Version="2.0.9" />
    <PackageReference Include="AngleSharp" Version="1.8.5" />
    <Content Include="../../.agents/skills/github-discussion/SKILL.md" Link="github-discussion/SKILL.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="$(ControllerReleaseNotesPath)" Link="RELEASE_NOTES.md" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(ControllerReleaseNotesPath)')" />
    <EmbeddedResource Include="repository-settings.json" LogicalName="repository-settings.json" />
    <Content Include="../../.agents/skills/repoagent-orientation/SKILL.md" Link="repoagent-orientation/SKILL.md" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="RepoAgentController.Tests" />
    <InternalsVisibleTo Include="NativeSmoke" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../RepoAgentController.Core/RepoAgentController.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../RepoAgent.LocalTelemetry/RepoAgent.LocalTelemetry.csproj" />
  </ItemGroup>
</Project>
