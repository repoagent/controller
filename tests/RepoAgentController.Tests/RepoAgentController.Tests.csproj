<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ControllerShutdownChild)' != 'true'">
    <!-- Each parent assembly names its own complete child output; concurrent builds never reuse a partial fixture. -->
    <_ControllerShutdownFixture>$([System.Guid]::NewGuid().ToString('N'))</_ControllerShutdownFixture>
  </PropertyGroup>
  <ItemGroup Condition="'$(ControllerShutdownChild)' != 'true'">
    <AssemblyMetadata Include="ControllerShutdownFixture" Value="$(_ControllerShutdownFixture)" />
  </ItemGroup>
  <PropertyGroup Condition="'$(ControllerShutdownChild)' == 'true'">
    <StartupObject>RepoAgentController.Tests.ControllerShutdownEntrypoint</StartupObject>
    <DefineConstants>$(DefineConstants);CONTROLLER_SHUTDOWN_CHILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.0.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
    <ProjectReference Include="../../src/RepoAgentController/RepoAgentController.csproj" />
    <EmbeddedResource Include="DiscussionJsonGolden.json" LogicalName="DiscussionJsonGolden.json" />
    <EmbeddedResource Include="StateFileWritten.json" LogicalName="StateFileWritten.json" />
    <EmbeddedResource Include="RefreshJournalWritten.txt" LogicalName="RefreshJournalWritten.txt" />
    <EmbeddedResource Include="ControllerStatusGolden.txt" LogicalName="ControllerStatusGolden.txt" />
    <EmbeddedResource Include="ControllerDashboardGolden.txt" LogicalName="ControllerDashboardGolden.txt" />
  </ItemGroup>
  <!-- Resolve descriptors from the actual project-reference build, including an isolated child artifacts path. -->
  <Target Name="CopyControllerRuntimeDescriptors" AfterTargets="Build">
    <MSBuild Projects="@(ProjectReference)" Targets="GetTargetPath" BuildInParallel="false">
      <Output TaskParameter="TargetOutputs" ItemName="_ControllerTarget" />
    </MSBuild>
    <ItemGroup>
      <_ControllerExecutable Include="@(_ControllerTarget)" Condition="'%(_ControllerTarget.Filename)' == 'repoagent'" />
      <_ControllerRuntimeDescriptor Include="@(_ControllerExecutable->'%(RootDir)%(Directory)repoagent.runtimeconfig.json')" />
      <_ControllerRuntimeDescriptor Include="@(_ControllerExecutable->'%(RootDir)%(Directory)repoagent.deps.json')" />
    </ItemGroup>
    <Copy SourceFiles="@(_ControllerRuntimeDescriptor)" DestinationFolder="$(OutDir)" />
  </Target>
  <Target Name="CopyControllerShutdownChild" DependsOnTargets="Build" Condition="'$(ControllerShutdownChild)' == 'true'">
    <Error Condition="'$(ControllerShutdownCopyDirectory)' == ''" Text="The child fixture needs its parent's unique output directory." />
    <ItemGroup>
      <_ControllerShutdownChildFile Include="$(TargetDir)**/*" Exclude="$(TargetDir)shutdown-child/**/*" />
    </ItemGroup>
    <!-- Copy within the child project, where RecursiveDir is still attached to the original glob items. -->
    <Copy SourceFiles="@(_ControllerShutdownChildFile)"
          DestinationFiles="@(_ControllerShutdownChildFile->'$(ControllerShutdownCopyDirectory)%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
  <Target Name="BuildControllerShutdownFixture" AfterTargets="Build" DependsOnTargets="CopyControllerRuntimeDescriptors"
          Condition="'$(ControllerShutdownChild)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_ControllerShutdownArtifacts>$(MSBuildProjectDirectory)/obj/shutdown-child/$(_ControllerShutdownFixture)</_ControllerShutdownArtifacts>
    </PropertyGroup>
    <!-- Restore evaluates without package imports; the separate build request then imports the fresh assets. -->
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Restore" BuildInParallel="false"
             RemoveProperties="OutDir;OutputPath;IntermediateOutputPath;BaseOutputPath;BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;StartupObject"
             Properties="ControllerShutdownChild=true;Configuration=$(Configuration);ArtifactsPath=$(_ControllerShutdownArtifacts);ExcludeRestorePackageImports=true" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="CopyControllerShutdownChild" BuildInParallel="false"
             RemoveProperties="OutDir;OutputPath;IntermediateOutputPath;BaseOutputPath;BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;StartupObject"
             Properties="ControllerShutdownChild=true;Configuration=$(Configuration);ArtifactsPath=$(_ControllerShutdownArtifacts);ControllerShutdownCopyDirectory=$(TargetDir)shutdown-child/$(_ControllerShutdownFixture)/" />
  </Target>
</Project>
